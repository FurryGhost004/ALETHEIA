  m_Script: {fileID: 11500000, guid: 35691d6ad6e610f4b8cd762bd2bfd486, type: 3}
  m_Name: Marcus-Who-Melody
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  _lines:
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Who was Melody seeing before she was killed?"'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Who else but the culprit, haha?"'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Wait, scratch that. She got struck from behind, so she wouldn''t
      have seen the killer anyway." '
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Point is, I''ve got no clue, kid. Go check her phone or interview
      the locals." '
