  m_Script: {fileID: 11500000, guid: 35691d6ad6e610f4b8cd762bd2bfd486, type: 3}
  m_Name: Marcus-How-Melody
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  _lines:
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"How was the killer able to approach Melody?"'
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Hmm...Three theories?"'
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"One: Burglar. Lockpicking''s basic stuff."'
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Two: Someone she knew."'
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Three: She left the door unlocked. Simple as that."'
