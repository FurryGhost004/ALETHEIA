  m_Script: {fileID: 11500000, guid: 35691d6ad6e610f4b8cd762bd2bfd486, type: 3}
  m_Name: Marcus-What-SebastianWine
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  _lines:
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"What do you think about Sebastian''s wine collection?"'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Fancy stuff. Thought I was in Arthur''s room for a second." '
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Kid''s a student, right? Since when do college kids collect wine?" '
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Where''d he get the cash for all this?" '
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Part-time pay sure as hell doesn''t cover it."'
