  m_Script: {fileID: 11500000, guid: 35691d6ad6e610f4b8cd762bd2bfd486, type: 3}
  m_Name: Marcus-What-Melody'sAutopsy
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  _lines:
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"What do you think about Melody''s autopsy ?"'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: 'Hmmm... '
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Autopsy says she''s victim number one. No signs of a struggle, so
      she probably got hit from behind."'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '" Question is, how did the bastard get to her? Either he was hiding
      under the bed before she walked in, or he just marched right through the front
      door."'
