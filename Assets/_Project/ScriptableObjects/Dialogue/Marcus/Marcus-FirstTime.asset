  m_Script: {fileID: 11500000, guid: 35691d6ad6e610f4b8cd762bd2bfd486, type: 3}
  m_Name: Marcus-FirstTime
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  _lines:
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Hey, Marcus. What''s the situation?"'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: "\"Pretty grim. Three victims\u2014the couple and their daughter.\""
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Forensics just hauled the bodies away. Autopsy reports will take
      a few days."'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"First time working a live crime scene, right? "'
  - _characterName: Marcus
    _characterPortrait: {fileID: 0}
    _content: '"Head inside, sweep the area, then start interviewing the neighbors."'
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Understood"'
