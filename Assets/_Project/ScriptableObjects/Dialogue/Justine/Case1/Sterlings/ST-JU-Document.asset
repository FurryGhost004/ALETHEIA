    _animationTrigger: 
  - _characterName: Justin
    _characterPortrait: {fileID: 0}
    _content: '"Oh right! Mr. Arthur is a chief architect, and Ms. Beatrice is an
      interior designer."'
    _animationTrigger: 
  - _characterName: Justin
    _characterPortrait: {fileID: 0}
    _content: '"So these are just their work documents."'
    _animationTrigger: 
  - _characterName: Justin
    _characterPortrait: {fileID: 0}
