  m_Script: {fileID: 11500000, guid: 35691d6ad6e610f4b8cd762bd2bfd486, type: 3}
  m_Name: Justine-melodyLamp
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  _lines:
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"A lamp in Melody''s room"'
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Hmm... other than the blood spatter on the lampshade, there''s nothing
      unusual about it." '
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"Wait, it isn''t damaged at all, and it didn''t even get knocked off
      the desk..." '
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"That... that means she died on the very first strike. She didn''t
      even get a chance to fight back." '
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"..." '
  - _characterName: Justine
    _characterPortrait: {fileID: 0}
    _content: '"At least... she didn''t have to suffer through any more blows after
      that." '
